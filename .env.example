# ---------------------------------------------------------------------------
# InsurAgent — configuración de entorno. Copiar a `.env` y completar.
# ---------------------------------------------------------------------------

# Proveedor LLM activo: anthropic | ollama | stub
INSURAGENT_LLM_PROVIDER=anthropic

# --- Anthropic (ruta principal, PRD §4.2) ---------------------------------
ANTHROPIC_API_KEY=
# Sólo si tu API key está ligada a una identidad (la API responde 400 pidiendo
# `anthropic-workspace-id`). Se obtiene en la consola: Settings → Workspaces.
ANTHROPIC_WORKSPACE_ID=
INSURAGENT_ANTHROPIC_MODEL=claude-opus-5
INSURAGENT_MAX_TOKENS=2048
# Profundidad de razonamiento: low | medium | high | xhigh | max
# `low` basta para el enrutamiento y mantiene el costo por sesión bajo (PRD §5).
INSURAGENT_EFFORT=low
# Reintentos ante 429 / 5xx / 529 'overloaded'. El default del SDK (2) no basta
# para una corrida de evaluación de decenas de peticiones seguidas.
INSURAGENT_MAX_RETRIES=5
# Nota: `temperature` no se envía — los modelos Opus 5 / Sonnet 5 rechazan
# parámetros de sampling con HTTP 400. El determinismo se logra vía
# structured outputs (output_config.format), no bajando la temperatura.

# --- Ollama (alternativa local de costo cero, PRD §8) ---------------------
INSURAGENT_OLLAMA_HOST=http://localhost:11434
INSURAGENT_OLLAMA_MODEL=qwen2.5:3b

# --- RAG -------------------------------------------------------------------
INSURAGENT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# sentence-transformers | hash  (hash = determinista y offline, sin descarga HF)
INSURAGENT_EMBEDDING_BACKEND=sentence-transformers
INSURAGENT_RAG_TOP_K=4

# --- Observabilidad (PRD §4.1) --------------------------------------------
INSURAGENT_LOG_LEVEL=INFO
INSURAGENT_TRACE_FILE=data/traces.jsonl
