# Plantilla de secretos para Streamlit Community Cloud.
#
# NO copiar este archivo al repositorio con valores reales: pegar su contenido
# en el panel "Secrets" de share.streamlit.io, que los inyecta en tiempo de
# ejecución sin que toquen el control de versiones.

ANTHROPIC_API_KEY = "sk-ant-..."
# Sólo si la llave está ligada a una identidad (la API responde 400 sin esto).
ANTHROPIC_WORKSPACE_ID = "wrkspc_..."

INSURAGENT_LLM_PROVIDER = "anthropic"
INSURAGENT_ANTHROPIC_MODEL = "claude-opus-5"
INSURAGENT_EFFORT = "low"
# En hosting gratuito no cabe PyTorch; el léxico del dominio da la misma
# precisión (15/15) con 214 MB de RSS.
INSURAGENT_EMBEDDING_BACKEND = "hash"
